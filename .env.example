# 複製成 data/.env 後填入。這個範本不含任何真的金鑰。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 只允許這些 LINE user id 使用（逗號分隔）
ALLOWED_USER_IDS=
# GitHub fine-grained token（Public repositories read-only）；沒填每小時只能查 60 次
GITHUB_TOKEN=
